{
  "name": "besnovatyj/yii2-cms-contracts",
  "description": "Нейтральные контракты (интерфейсы) ядра Yii2 CMS: разделяемые абстракции между модулями, менеджером модулей и подсистемами. Не зависит ни от чего тяжёлого.",
  "version": "1.0.0",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "keywords": [
    "yii2",
    "cms",
    "contracts"
  ],
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\Contracts\\": "src/"
    }
  }
}
